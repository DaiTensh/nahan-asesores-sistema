[Unit]
Description=Nahan Asesores - Notificacion de vencimientos proximos (RF53)
After=network.target mysql.service

[Service]
Type=oneshot
User=ubuntu
Group=www-data
WorkingDirectory=/var/www/nahan-asesores-sistema
EnvironmentFile=/var/www/nahan-asesores-sistema/.env
ExecStart=/var/www/nahan-asesores-sistema/venv/bin/python -m backend.tareas_programadas

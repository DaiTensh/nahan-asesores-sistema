FLASK_ENV=production
DEBUG=false
SECRET_KEY=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=nahan_asesores
# Segundos que se espera para conectar con MySQL antes de fallar (por defecto 10).
DB_CONNECT_TIMEOUT=10

# En producción con HTTPS debe ser true (con false la cookie de sesión también viaja por HTTP).
# No ponerla en true mientras el sitio se sirva solo por HTTP: nadie podría iniciar sesión.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
# Duración de la sesión de Flask, en minutos. PERMANENT_SESSION_LIFETIME tiene
# prioridad; si se omite, se usa SESSION_LIFETIME_MINUTES (480 por defecto).
# El cierre por inactividad (RF59) se configura aparte, desde la aplicación.
PERMANENT_SESSION_LIFETIME=480
SESSION_LIFETIME_MINUTES=480

# CSRF: las escrituras (POST/PUT/PATCH/DELETE) de /api/ cuyo encabezado Origin no coincide con el
# nombre de host de la solicitud ni figura en ALLOWED_ORIGINS se rechazan con 403. Solo se desactiva
# (false) para diagnosticar un proxy mal configurado.
CSRF_COMPROBAR_ORIGEN=true
# Control de horas: a partir de cuántas horas continuas el sistema AVISA y pide confirmación antes de
# cerrar un temporizador. Es una protección técnica, no un límite: la duración real se guarda completa.
# 0 desactiva el aviso.
TEMPORIZADOR_AVISO_HORAS=12
ALLOWED_ORIGINS=
TRUST_PROXY=true
APP_TIMEZONE=America/Santiago

# RF26 — Restablecimiento de contraseña.
# El enlace de restablecimiento solo sale por correo, así que RF26 necesita SMTP real
# en producción. Con estas claves vacías el sistema arranca igual, pero en producción
# no se envía nada y el enlace NO se registra en el log (sería un secreto en un archivo).
# Solo con FLASK_ENV=development el contenido del correo queda en el log, para probar.
# El puerto 25 está bloqueado en la instancia EC2; usar 587 con STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Nahan Asesores
APP_URL_FRONTEND=http://127.0.0.1:5500/frontend
RESET_TOKEN_MINUTOS=60

# RF54 — Adjuntando Archivos a Tareas.
# Carpeta donde se guardan los adjuntos, fuera del repositorio. En el EC2
# apunta al volumen montado para esto; si se deja vacía, cae por defecto a
# uploads/tareas dentro del proyecto (ya ignorada por git).
ADJUNTOS_DIR=

# Techo, en MB, del cuerpo de cualquier solicitud (Flask MAX_CONTENT_LENGTH).
# Debe coincidir con client_max_body_size de la ruta de adjuntos en
# deploy/nginx/nahan.conf y superar ADJUNTOS_TAMANO_MAXIMO_MB (MySQL).
MAX_CONTENT_LENGTH_MB=64

# RF53 — Notificando el vencimiento de tareas.
# Días de anticipación con que el proceso programado
# (deploy/systemd/nahan-vencimientos.*) avisa del vencimiento. Por defecto, 3.
DIAS_ANTICIPACION_VENCIMIENTO=3

# RF60 — Respaldando históricamente la información.
# Carpeta donde se guardan los paquetes de respaldo. Debe ser una ruta absoluta
# FUERA del proyecto; para cumplir el almacenamiento separado (CA5) tiene que
# estar en un volumen o destino distinto del disco de la aplicación (p. ej. un
# volumen adicional montado en /mnt/nahan-respaldos). Si queda vacía, los
# respaldos se rechazan. Se crea con permisos 0700.
RESPALDO_DIR=
# Cantidad máxima de paquetes que se conservan (mínimo 3).
RESPALDO_RETENCION_MAXIMA=30
# Con true, un respaldo falla si RESPALDO_DIR está en el mismo dispositivo que la
# aplicación (protege de escribir en el disco raíz si el volumen no está montado).
# EN PRODUCCIÓN DEBE SER true: con false el respaldo cae al disco de la aplicación
# y solo se avisa, lo que incumple el almacenamiento separado (CA5).
RESPALDO_EXIGIR_DISPOSITIVO_SEPARADO=false
RESPALDO_TIMEOUT_SEGUNDOS=600
RESPALDO_MAX_MB=4096
MYSQLDUMP_BIN=mysqldump
# Cuenta de MySQL del respaldo (solo lectura basta). Vacía = usa DB_USER/DB_PASSWORD.
RESPALDO_DB_USER=
RESPALDO_DB_PASSWORD=
# La restauración reemplaza datos: viene deshabilitada. Habilítela solo en el
# entorno donde corresponda. RESTAURACION_DB_NAME vacía = la base activa (DB_NAME);
# la cuenta debe poder hacer DROP/CREATE/INSERT en esa base (vacía = DB_USER).
RESTAURACION_HABILITADA=false
RESTAURACION_DB_NAME=
RESTAURACION_DB_USER=
RESTAURACION_DB_PASSWORD=
